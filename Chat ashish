package com.example.smartaichat;
public class Message {
    public String senderId, text, mediaUrl, type;
    public long timestamp;
    public Message() {}
    public Message(String senderId, String text, long timestamp, String mediaUrl, String type) {
        this.senderId = senderId; this.text = text;
        this.timestamp = timestamp; this.mediaUrl = mediaUrl; this.type = type;
    }
}

