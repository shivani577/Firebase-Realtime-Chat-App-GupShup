package com.example.smartaichat;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.view.View;
import android.widget.EditText;
import android.widget.ImageButton;
import androidx.annotation.Nullable;
import androidx.appcompat.app.AppCompatActivity;
import androidx.recyclerview.widget.LinearLayoutManager;
import androidx.recyclerview.widget.RecyclerView;
import com.google.firebase.auth.FirebaseAuth;
import com.google.firebase.database.*;
import com.google.firebase.storage.FirebaseStorage;
import com.google.firebase.storage.StorageReference;
import com.vanniktech.emoji.EmojiPopup;
import java.util.*;

public class MainActivity extends AppCompatActivity {
    private static final int PICK_MEDIA = 1001;
    private String currentUserId;
    private DatabaseReference messagesRef;
    private RecyclerView rvMessages;
    private MessageAdapter adapter;
    private EditText etMessage;
    private EmojiPopup emojiPopup;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        // Firebase Auth
        currentUserId = FirebaseAuth.getInstance().getCurrentUser().getUid();
        messagesRef = FirebaseDatabase.getInstance().getReference("chatRooms")
                .child("globalRoom") // for simplicity one room
                .child("messages");

        // RecyclerView
        rvMessages = findViewById(R.id.rvMessages);
        rvMessages.setLayoutManager(new LinearLayoutManager(this));
        adapter = new MessageAdapter(currentUserId);
        rvMessages.setAdapter(adapter);

        // Load messages
        messagesRef.addValueEventListener(new ValueEventListener() {
            @Override public void onDataChange(DataSnapshot snap) {
                List<Message> list = new ArrayList<>();
                for (DataSnapshot ds : snap.getChildren()) {
                    list.add(ds.getValue(Message.class));
                }
                adapter.submitList(list);
                rvMessages.scrollToPosition(list.size()-1);
            }
            @Override public void onCancelled(DatabaseError e) {}
        });

        // Input & Emoji
        etMessage = findViewById(R.id.etMessage);
        View rootView = findViewById(R.id.rootLayout);
        emojiPopup = EmojiPopup.Builder.fromRootView(rootView).build(etMessage);
        findViewById(R.id.btnEmoji).setOnClickListener(v -> emojiPopup.toggle());

        // Send text
        findViewById(R.id.btnSend).setOnClickListener(v -> {
            String txt = etMessage.getText().toString().trim();
            if (txt.isEmpty()) return;
            Message msg = new Message(currentUserId, txt, System.currentTimeMillis(), null, "text");
            messagesRef.push().setValue(msg);
            etMessage.setText("");
        });

        // Attach media
        findViewById(R.id.btnAttach).setOnClickListener(v -> {
            Intent i = new Intent(Intent.ACTION_GET_CONTENT);
            i.setType("image/* video/*");
            startActivityForResult(i, PICK_MEDIA);
        });
    }

    @Override protected void onActivityResult(int req, int res, @Nullable Intent data) {
        super.onActivityResult(req, res, data);
        if (req == PICK_MEDIA && res == RESULT_OK && data != null) {
            Uri uri = data.getData();
            StorageReference storRef = FirebaseStorage.getInstance()
                    .getReference("chatMedia")
                    .child(UUID.randomUUID().toString());
            storRef.putFile(uri).continueWithTask(task -> storRef.getDownloadUrl())
                .addOnSuccessListener(url -> {
                    String type = getContentResolver().getType(uri).startsWith("image") ? "image" : "video";
                    Message msg = new Message(currentUserId, null, System.currentTimeMillis(), url.toString(), type);
                    messagesRef.push().setValue(msg);
                });
        }
    }
}

