package com.example.smartaichat;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.ImageView;
import android.widget.TextView;
import androidx.recyclerview.widget.*;
import com.bumptech.glide.Glide;
import java.text.SimpleDateFormat;
import java.util.*;

public class MessageAdapter extends ListAdapter<Message, RecyclerView.ViewHolder> {
    private String me;
    private static final int TYPE_ME = 1, TYPE_OTHER = 2;
    public MessageAdapter(String myId) { super(DIFF); me = myId; }
    @Override public int getItemViewType(int pos) {
        return getItem(pos).senderId.equals(me) ? TYPE_ME : TYPE_OTHER;
    }
    @Override public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup p, int vt) {
        int lay = vt==TYPE_ME? R.layout.item_me : R.layout.item_other;
        return new VH(LayoutInflater.from(p.getContext()).inflate(lay,p,false));
    }
    @Override public void onBindViewHolder(RecyclerView.ViewHolder h, int pos) {
        VH vh = (VH)h; Message m = getItem(pos);
        if ("text".equals(m.type)) {
            vh.tvText.setText(m.text); vh.ivMedia.setVisibility(View.GONE);
        } else {
            vh.tvText.setVisibility(View.GONE);
            vh.ivMedia.setVisibility(View.VISIBLE);
            Glide.with(vh.ivMedia).load(m.mediaUrl).into(vh.ivMedia);
        }
        vh.tvTime.setText(new SimpleDateFormat("hh:mm a", Locale.getDefault()).format(new Date(m.timestamp)));
    }
    static class VH extends RecyclerView.ViewHolder {
        TextView tvText, tvTime; ImageView ivMedia;
        VH(View v) { super(v);
            tvText = v.findViewById(R.id.tvText);
            tvTime = v.findViewById(R.id.tvTime);
            ivMedia = v.findViewById(R.id.ivMedia);
        }
    }
    private static final DiffUtil.ItemCallback<Message> DIFF =
        new DiffUtil.ItemCallback<Message>() {
      @Override public boolean areItemsTheSame(Message a, Message b) {
          return a.timestamp==b.timestamp;
      }
      @Override public boolean areContentsTheSame(Message a, Message b) {
          return a.equals(b);
      }
    };
}

